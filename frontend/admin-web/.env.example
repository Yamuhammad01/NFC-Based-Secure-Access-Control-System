# ===========================================
# NFC Access Control System - Admin Dashboard (Vite + React)
# Environment Variables
# ===========================================

# API base URL for the Express backend.
# - Local development: http://localhost:5000/api (default fallback in code)
# - Vercel/other hosts: https://<your-backend>.vercel.app/api
# NOTE: admin-web is a Vite app, so the variable MUST use the VITE_ prefix.
VITE_API_URL=http://localhost:5000/api