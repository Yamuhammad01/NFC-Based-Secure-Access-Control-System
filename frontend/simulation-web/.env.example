# ===========================================
# NFC Access Control System - Tap Simulator (Next.js)
# Environment Variables
# ===========================================

# API base URL for the Express backend (WITH the /api prefix).
# The code appends '/access/tap' and '/access/logs'
# (e.g. fetch(`${NEXT_PUBLIC_BACKEND_URL}/access/tap`)).
# - Local development: http://localhost:5000/api
# - Vercel/other hosts: https://<your-backend>.vercel.app/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000/api