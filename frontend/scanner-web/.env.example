# ===========================================
# NFC Access Control System - QR Scanner (Next.js)
# Environment Variables
# ===========================================

# Root URL of the Express backend, WITHOUT the /api prefix.
# The code appends '/api/scan' (e.g. fetch(`${NEXT_PUBLIC_API_URL}/api/scan`)).
# - Local development: http://localhost:5000
# - Vercel/other hosts: https://<your-backend>.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:5000

# API base URL (WITH the /api prefix) used by the tap-verification service.
# The code appends '/access/tap' (e.g. fetch(`${NEXT_PUBLIC_VERIFICATION_URL}/access/tap`)).
# - Local development: http://localhost:5000/api
# - Vercel/other hosts: https://<your-backend>.vercel.app/api
NEXT_PUBLIC_VERIFICATION_URL=http://localhost:5000/api